{
  "manifest_version": 3,
  "name": "Inferno Engagement Extension",
  "version": "1.0",
  "description": "Gamified Canvas extension to enhance student engagement and provide instructors with insights.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "*://*.instructure.com/*",
    "*://canvas.asu.edu/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instructure.com/*",
        "*://canvas.asu.edu/*"
      ],
      "js": [
        "pairsStore.js",
        "contentScript.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Inferno",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/avatar.png"],
      "matches": ["*://*/*"]
    }
  ]
}
